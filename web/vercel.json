{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/alerts",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/monthly",
      "schedule": "30 2 1 * *"
    }
  ],
  "functions": {
    "api/ground.py": {
      "maxDuration": 30,
      "excludeFiles": "{.next/**,node_modules/**,public/**,src/**,e2e/**,tests/**,lighthouse/**,test-results/**,messages/**,scripts/**}"
    }
  }
}
