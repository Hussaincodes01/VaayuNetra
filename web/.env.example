NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server routes only
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPILLARY_TOKEN=
RESEND_API_KEY=
SMTP_HOST=                        # free alternative to Resend: smtp.gmail.com (no domain needed)
SMTP_PORT=                        # 465
SMTP_USER=                        # the Gmail address
SMTP_PASS=                        # server only: a Gmail app password
ALERT_FROM_EMAIL=alerts@your-domain
ANTHROPIC_API_KEY=
GROQ_API_KEY=                     # server only: "Explain this site" briefings
GROQ_MODEL=                       # optional, default qwen/qwen3.8-27b
NEXT_PUBLIC_SITE_URL=https://vayunetra-india.vercel.app
NEXT_PUBLIC_VIDEO_URL=https://www.youtube.com/watch?v=NFfkrmYtKDA  # the film (YouTube/Vimeo link or video file URL)
CRON_SECRET=                      # server only: Vercel Cron sends it as "Authorization: Bearer ..."
ALERT_LOOKBACK_DAYS=              # optional, default 30: older passes never trigger an alert
ALERTS_TWILIO_ENABLED=false       # feature flag for WhatsApp/SMS alerts
TWILIO_ACCOUNT_SID=               # server only, optional
TWILIO_AUTH_TOKEN=                # server only, optional
TWILIO_FROM=                      # +1... for SMS, or whatsapp:+1... for WhatsApp
FIRMS_MAP_KEY=                    # server only, optional: NASA FIRMS key for the landfill fire log
PARTNER_API_KEYS=                 # server only, optional: {"ecosathi":"<random key, 24+ characters>"}
