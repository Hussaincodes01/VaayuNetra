NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server routes only
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPILLARY_TOKEN=
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@your-domain
ANTHROPIC_API_KEY=
GROQ_API_KEY=                     # server only: "Explain this site" briefings
GROQ_MODEL=                       # optional, default llama-3.3-70b-versatile
NEXT_PUBLIC_SITE_URL=https://vayunetra.vercel.app
NEXT_PUBLIC_VIDEO_URL=            # YouTube/Vimeo embed or Vercel Blob URL of the film
CRON_SECRET=                      # server only: Vercel Cron sends it as "Authorization: Bearer ..."
ALERT_LOOKBACK_DAYS=              # optional, default 30: older passes never trigger an alert
ALERTS_TWILIO_ENABLED=false       # feature flag for WhatsApp/SMS alerts
TWILIO_ACCOUNT_SID=               # server only, optional
TWILIO_AUTH_TOKEN=                # server only, optional
TWILIO_FROM=                      # +1... for SMS, or whatsapp:+1... for WhatsApp
